# Домен берётся из SITE_DOMAIN в .env — файл править не нужно, иначе на сервере
# каждый `git pull` конфликтовал бы с локальной правкой.
{$SITE_DOMAIN} {
    encode gzip
    reverse_proxy app:8000

    # Админка открыта из интернета: администрировать нужно удалённо, а не только
    # с ноутбука через SSH-туннель. Единственное, что её защищает, — ADMIN_SECRET
    # (256 бит, POST-формой, с паузой после пяти неудач на адрес) и подписанная
    # cookie на 8 часов. Второго фактора нет: утёк секрет — доступ у любого, кто
    # его увидел. Чтобы закрыть обратно, верни эти две строки и перечитай конфиг:
    #     @admin path /admin*
    #     respond @admin 404
    # SSH-туннель из DEPLOY.md продолжает работать в любом случае.

    header {
        Strict-Transport-Security "max-age=31536000"
        X-Content-Type-Options "nosniff"
        X-Frame-Options "DENY"
        Referrer-Policy "same-origin"
    }
}
