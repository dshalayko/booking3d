# Скопируй в .env и заполни. Секреты генерируй: openssl rand -hex 32

TZ=Europe/Nicosia
PUBLIC_BASE_URL=http://localhost:8000

# Домен для Caddy на проде: по нему выдаётся сертификат Let's Encrypt. Локально
# не используется. Должен совпадать с хостом в PUBLIC_BASE_URL.
SITE_DOMAIN=printers.example.com

# Язык интерфейса и бота: ru или en. Меняется без перевыкладки, нужен рестарт.
UI_LANG=ru

# Принтеры для первого запуска, через запятую (запятой в имени быть не может).
# Обязательная строка: дефолта в коде нет, чтобы имена жили в одном месте — без
# неё приложение не поднимется. Имя видно на стене и в каждом сообщении бота.
# Кавычки обязательны, если в имени есть #: иначе dotenv обрежет строку как
# комментарий.
#
# Дальше парк живёт в БД и правится из админки, вкладка «Оборудование»: там же
# заводятся гравировщики, которых в этой строке нет и быть не может.
# `cli seed_printers` только досоздаёт недостающие принтеры по имени —
# переименовать уже созданный правкой этой строки нельзя, см. app/cli.py.
PRINTER_NAMES="P2S #1,P2S #2"

# Пароль БД используется и в DATABASE_URL, и контейнером postgres
DB_PASSWORD=change-me
DATABASE_URL=postgresql+psycopg://booking:change-me@localhost:5432/booking

TG_BOT_TOKEN=

# Тестовый режим: занимать принтеры и вставать в очередь можно с любого
# устройства, а не только с зарегистрированного планшета. Нужен, чтобы прогнать
# цикл до того, как iPad повешен на стену. С ним PIN из четырёх цифр открыт
# перебору из интернета — выключай, как только закончил проверять.
KIOSK_OPEN_ACCESS=false

SESSION_SECRET=
KIOSK_SECRET=
KIOSK_ENROLL_SECRET=
ADMIN_SECRET=
# Перец для PIN. Его ротация обнуляет все PIN-ы — их придётся выдать заново.
PIN_PEPPER=

# Окно на подтверждение предложения из очереди, минут
OFFER_WINDOW_MINUTES=30

# Ночная пауза: в этом окне таймер предложения не тикает
NIGHT_START=23:00
NIGHT_END=08:00

# Через сколько минут после окончания печати напомнить забрать деталь
UNCLAIMED_PING_MINUTES=60
